      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "editorMode": "code", "expr": "topk(10, sum by (name) (rate(container_fs_reads_bytes_total{job=\"cadvisor\",name!=\"\"}[$__rate_interval])))", "legendFormat": "{{name}} read", "range": true, "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "editorMode": "code", "expr": "topk(10, sum by (name) (rate(container_fs_writes_bytes_total{job=\"cadvisor\",name!=\"\"}[$__rate_interval])))", "legendFormat": "{{name}} write", "range": true, "refId": "B" }
      ],
      "title": "I/O disque par conteneur",
