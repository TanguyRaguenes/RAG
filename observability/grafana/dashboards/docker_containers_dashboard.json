      "targets": [ { "datasource": { "type": "prometheus", "uid": "prometheus" }, "editorMode": "code", "expr": "topk(10, sum by (name) (container_memory_working_set_bytes{job=\"cadvisor\",name!=\"\"}))", "legendFormat": "{{name}}", "range": true, "refId": "A" } ],
      "title": "Memoire par conteneur",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Debit reseau entrant et sortant par conteneur.",
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
