# Configuration racine Docker Compose
# Les commentaires documentent chaque variable; les valeurs restent propres a l environnement.
# --- Images Docker ---
# Namespace Docker Hub utilise pour telecharger les images RAG en production.
DOCKERHUB_NAMESPACE=tanguyraguenes

# --- Alerting ---
# Webhook Discord utilise par Grafana pour envoyer les alertes.
DISCORD_WEBHOOK_URL=CHANGE_ME_DISCORD_WEBHOOK_URL

# --- Base de donnees PostgreSQL ---
# Nom de la base relationnelle utilisee par les services RAG.
POSTGRES_DB=rag_usage
# Utilisateur PostgreSQL utilise par les services applicatifs.
POSTGRES_USER=rag_user
# Mot de passe de l utilisateur PostgreSQL.
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD

# --- Domaines publics ---
# Nom de domaine public de l IHM expose par Caddy.
RAG_IHM_HOST=rag.example.com
# Nom de domaine public du MCP expose par Caddy.
RAG_MCP_HOST=mcp.example.com
# Nom de domaine public de Pocket ID expose par Caddy.
RAG_AUTH_HOST=auth.example.com
# Nom de domaine public de Grafana expose par Caddy.
RAG_GRAFANA_HOST=grafana.example.com

# --- Authentification IHM ---
# URL authorize OIDC appelee depuis le navigateur.
RAG_IHM_OIDC_AUTHORIZE_URL=https://auth.example.com/authorize
# URL token OIDC utilisee pour echanger le code OAuth.
RAG_IHM_OIDC_TOKEN_URL=https://auth.example.com/api/oidc/token
# URI de redirection OAuth/OIDC configuree pour l IHM.
RAG_IHM_OIDC_REDIRECT_URI=https://rag.example.com

# --- Volumes hotes ---
# Chemin des wikis Markdown sur la machine hote, monte dans rag_embedder.
RAG_WIKIS_PATH=/opt/rag/wikis
# Chemin du dataset d evaluation sur la machine hote.
RAG_EVALUATOR_DATASET_PATH=/opt/rag/rag_evaluator/dataset.json
