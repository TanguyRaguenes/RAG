# Configuration rag_mcp
# Les commentaires documentent chaque variable; les valeurs restent propres a l environnement.
# --- Authentification MCP ---
# Issuer attendu dans les tokens OIDC recus par le MCP.
RAG_MCP_OIDC_ISSUER=https://auth.example.com
# URL interne JWKS utilisee par le MCP pour verifier les tokens.
RAG_MCP_OIDC_JWKS_URI=http://pocket-id:1411/.well-known/jwks.json
# Audiences OAuth/OIDC acceptees par le MCP.
RAG_MCP_OIDC_ALLOWED_AUDIENCES=https://mcp.example.com/
# Scopes requis pour autoriser l acces au MCP.
RAG_MCP_REQUIRED_SCOPES=rag:mcp
# URL publique du resource server MCP annoncee aux clients OAuth.
RAG_MCP_RESOURCE_SERVER_URL=https://mcp.example.com
