#!/bin/sh
set -eu

ENV_FILE="{{ deploy_dir }}/.env"
RAG_WIKIS_PATH_FROM_ENV=""

if [ -f "$ENV_FILE" ]; then
    # Ansible can copy .env files created on Windows, whose CRLF line endings add a trailing \r.
    RAG_WIKIS_PATH_FROM_ENV=$(sed -n 's/^RAG_WIKIS_PATH=//p' "$ENV_FILE" | tr -d '\r' | tail -n 1)
fi

WIKIS_DIR=${RAG_WIKIS_PATH:-${RAG_WIKIS_PATH_FROM_ENV:-{{ deploy_dir }}/wikis}}

log() {
    printf '%s %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$*"
}

echo "============================================================"
log "RAG wiki ingestion started"

if [ ! -d "$WIKIS_DIR" ]; then
    log "RAG wiki ingestion failed: ingestion not triggered because wiki directory does not exist: $WIKIS_DIR"
    echo "============================================================"
    exit 1
fi

if [ -z "$(find "$WIKIS_DIR" -type f -name '*.md' ! -path '*/.git/*' -print -quit)" ]; then
    log "RAG wiki ingestion failed: ingestion not triggered because wiki directory is empty or contains no Markdown files: $WIKIS_DIR"
    echo "============================================================"
    exit 1
fi

echo "Ingesting wiki documents"
RESPONSE_FILE=$(mktemp)
trap 'rm -f "$RESPONSE_FILE"' EXIT

if ! HTTP_STATUS=$(curl -sS -o "$RESPONSE_FILE" -w '%{http_code}' -X POST http://127.0.0.1:8002/ingest/bulk); then
    printf '\n'
    log "RAG wiki ingestion failed: rag_embedder is unreachable"
    echo "============================================================"
    exit 1
fi

cat "$RESPONSE_FILE"
printf '\n'

case "$HTTP_STATUS" in
    2??) ;;
    *)
        log "RAG wiki ingestion failed: bulk ingestion request returned HTTP $HTTP_STATUS"
        echo "============================================================"
        exit 1
        ;;
esac

log "RAG wiki ingestion finished"
echo "============================================================"
