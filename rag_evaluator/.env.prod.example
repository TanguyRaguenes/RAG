# Configuration rag_evaluator
# Les commentaires documentent chaque variable; les valeurs restent propres a l environnement.
# --- Logs ---
# Niveau de logs applicatifs JSON.
LOG_LEVEL=INFO
# Nom du service ajoute aux logs structures.
SERVICE_NAME=rag_evaluator

# --- Provider IA ---
# Cle API du fournisseur LLM ou compatible OpenAI.
OPEN_API_KEY=CHANGE_ME_OPENAI_OR_COMPATIBLE_API_KEY

# --- Services internes RAG ---
# URL interne de l orchestrator pour poser une question pendant l evaluation.
RAG_ORCHESTRATOR_ASK_QUESTION_URL=http://rag_orchestrator:8000/ask_question

# --- Dataset ---
# Chemin du dataset monte dans le conteneur evaluator.
DATASET_PATH=/data/dataset.json
