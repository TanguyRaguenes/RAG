# Configuration rag_orchestrator
# Les commentaires documentent chaque variable; les valeurs restent propres a l environnement.
# --- Provider IA ---
# Cle API du fournisseur LLM ou compatible OpenAI.
OPEN_API_KEY=CHANGE_ME_OPENAI_OR_COMPATIBLE_API_KEY

# --- Authentification OIDC ---
# Issuer attendu dans les tokens OIDC valides par le service.
OIDC_ISSUER=https://auth.example.com
# URL interne permettant de recuperer les cles publiques JWKS de Pocket ID.
OIDC_JWKS_URI=http://pocket-id:1411/.well-known/jwks.json
# URL interne userinfo utilisee pour enrichir le profil utilisateur.
OIDC_USERINFO_URL=http://pocket-id:1411/api/oidc/userinfo
# Audiences OAuth/OIDC acceptees par le service.
OIDC_ALLOWED_AUDIENCES=CHANGE_ME_IHM_CLIENT_ID,CHANGE_ME_MCP_CLIENT_ID

# --- Pocket ID ---
# Cle API serveur utilisee pour interroger l API Pocket ID.
POCKET_ID_API_KEY=CHANGE_ME_CLEF_API

# --- Base de donnees PostgreSQL ---
# URL de connexion PostgreSQL utilisee par le service.
DATABASE_URL=postgresql://rag_user:CHANGE_ME_STRONG_POSTGRES_PASSWORD@postgres:5432/rag_usage

# --- Quotas et identite ---
# Secret utilise pour deriver les identifiants techniques lies aux utilisateurs.
USER_HASH_SECRET=CHANGE_ME_RANDOM_HEX_SECRET
# Quota mensuel de tokens applique par defaut aux nouveaux utilisateurs.
DEFAULT_USER_MONTHLY_TOKEN_QUOTA=100000

# --- Administration ---
# Groupes autorises a administrer les usages et quotas.
RAG_USAGE_ADMIN_GROUPS=rag_admin
