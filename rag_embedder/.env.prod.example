# Configuration rag_embedder
# Les commentaires documentent chaque variable; les valeurs restent propres a l environnement.
# --- Logs ---
# Niveau de logs applicatifs JSON.
LOG_LEVEL=INFO
# Nom du service ajoute aux logs structures.
SERVICE_NAME=rag_embedder

# --- Services internes RAG ---
# URL interne du retriever pour enregistrer les chunks vectorises.
RAG_RETRIEVER_INGEST_DOCUMENTS_URL=http://rag_retriever:8000/save_items

# --- Donnees documentaires ---
# Chemin des wikis montes en lecture seule dans le conteneur embedder.
RAG_WIKIS_DIR=/data/wikis
