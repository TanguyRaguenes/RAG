# Configuration pocket-id
# Les commentaires documentent chaque variable; les valeurs restent propres a l environnement.
# --- Pocket ID ---
# URL publique de Pocket ID utilisee pour generer les liens et metadonnees OIDC.
APP_URL=https://auth.example.com
# Cle de chiffrement interne de Pocket ID.
ENCRYPTION_KEY=CHANGE_ME_32_BYTE_BASE64_ENCRYPTION_KEY
