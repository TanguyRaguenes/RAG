FROM python:3.12-slim

# Le cache uv peut être sur un autre système de fichiers dans Docker.
ENV UV_LINK_MODE=copy
ENV UV_PROJECT_ENVIRONMENT=/opt/venv

WORKDIR /workspace
ENV PYTHONPATH=/workspace

RUN pip install --no-cache-dir --only-binary :all: uv

# Installer les dépendances avant le code optimise le cache des couches Docker.
COPY pyproject.toml uv.lock ./

ENV UV_HTTP_TIMEOUT=300
ARG DEBUG=0
RUN if [ "$DEBUG" = "1" ]; then \
      uv sync --frozen --dev; \
    else \
      uv sync --frozen --no-dev; \
    fi

COPY app ./app

RUN useradd --create-home --uid 10001 appuser && chown -R appuser:appuser /workspace /opt/venv
USER appuser

CMD ["sh", "-lc", "\
  if [ \"$DEBUG\" = \"1\" ]; then \
    exec uv run --no-sync python -Xfrozen_modules=off -m debugpy \
      --listen 0.0.0.0:5678 \
      -m streamlit run app/main.py --server.port=8501 --server.address=0.0.0.0 --server.enableCORS=false --server.enableXsrfProtection=false; \
  else \
    exec uv run --no-sync streamlit run app/main.py --server.port=8501 --server.address=0.0.0.0 --server.enableCORS=false --server.enableXsrfProtection=false; \
  fi \
"]
