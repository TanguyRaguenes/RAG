# Configuration rag_ihm
# Les commentaires documentent chaque variable; les valeurs restent propres a l environnement.
# --- Logs ---
# Niveau de logs applicatifs JSON.
LOG_LEVEL=INFO
# Nom du service ajoute aux logs structures.
SERVICE_NAME=rag_ihm

# --- Authentification IHM ---
# Identifiant OAuth/OIDC du client IHM declare dans Pocket ID.
RAG_IHM_OIDC_CLIENT_ID=CHANGE_ME_IHM_CLIENT_ID
# Secret OAuth/OIDC du client IHM declare dans Pocket ID.
RAG_IHM_OIDC_CLIENT_SECRET=CHANGE_ME_IHM_CLIENT_SECRET
# URL authorize OIDC appelee depuis le navigateur.
RAG_IHM_OIDC_AUTHORIZE_URL=https://auth.example.com/authorize
# URL token OIDC utilisee pour echanger le code OAuth.
RAG_IHM_OIDC_TOKEN_URL=https://auth.example.com/api/oidc/token
# URI de redirection OAuth/OIDC configuree pour l IHM.
RAG_IHM_OIDC_REDIRECT_URI=https://rag.example.com
# Scopes demandes par l IHM.
RAG_IHM_OIDC_SCOPE=openid email profile groups

# --- Administration ---
# Groupes autorises a administrer les usages et quotas.
RAG_USAGE_ADMIN_GROUPS=rag_admin
# Groupes autorises a acceder aux fonctions admin de l IHM.
RAG_IHM_ADMIN_GROUPS=rag_admin

# --- Services internes RAG ---
# URL interne de healthcheck orchestrator.
RAG_ORCHESTRATOR_TEST_CONNEXION_URL=http://rag_orchestrator:8000/
# URL interne de healthcheck evaluator.
RAG_EVALUATOR_TEST_CONNEXION_URL=http://rag_evaluator:8000/
# URL interne orchestrator pour poser une question.
RAG_ORCHESTRATOR_ASK_QUESTION_URL=http://rag_orchestrator:8000/ask_question
# URL interne evaluator pour lancer une evaluation RAG.
RAG_EVALUATOR_EVALUATE_RAG_URL=http://rag_evaluator:8000/evaluate_rag
